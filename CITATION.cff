    affiliation: "Department of Computer Science, Troy University, AL, USA"
  - family-names: Momin
    given-names: Ayan
    email: amomin@troy.edu
    affiliation: "Department of Computer Science, Troy University, AL, USA"
license: MIT
keywords:
  - molecular generation
  - equivariant diffusion
  - generative models
  - OE62
  - inverse design
